// Vercel serverless function — POST /api/chat
//
// Stateless proxy to the Gemini API. Keeps GEMINI_API_KEY server-side only; the frontend
// (index.html) never sees it. This file contains ZERO TNEA logic — searchColleges(),
// compareColleges(), manageChoiceList(), etc. exist in exactly one place (index.html) and run
// in the browser. This function only ever forwards the "contents"/"tools" the frontend already
// built (see the GEMINI_TOOL_DECLARATIONS / runGeminiTurn code in index.html) to Gemini, adds
// the API key, and hands the raw response parts back — nothing here decides TNEA intent, and
// nothing here duplicates a single dataset lookup.

// Verified against Google's Gemini API docs (Aug 2026): gemini-3.6-flash is the current GA
// (non-preview) Flash model. If Google deprecates it later, change only this constant.
const GEMINI_MODEL = "gemini-3.6-flash";
const GEMINI_URL = `https://generativelanguage.googleapis.com/v1beta/models/${GEMINI_MODEL}:generateContent`;

module.exports = async (req, res) => {
  // Quick health check: open /api/chat directly in a browser (GET) to confirm the function is
  // deployed and the key is configured, without spending a Gemini call.
  if (req.method === "GET") {
    res.status(200).json({
      ok: true,
      model: GEMINI_MODEL,
      geminiKeyConfigured: Boolean(process.env.GEMINI_API_KEY)
    });
    return;
  }

  if (req.method !== "POST") {
    res.status(405).json({ error: "Method not allowed" });
    return;
  }

  const apiKey = process.env.GEMINI_API_KEY;
  if (!apiKey) {
    res.status(500).json({
      error: "GEMINI_API_KEY is not configured on the server.",
      fix: "Add GEMINI_API_KEY in Vercel → Project → Settings → Environment Variables, then redeploy."
    });
    return;
  }

  try {
    // Vercel Node functions auto-parse a JSON body into req.body.
    const { contents, system, tools } = req.body || {};
    if (!Array.isArray(contents) || !contents.length) {
      res.status(400).json({ error: "Missing 'contents' array in request body." });
      return;
    }

    const geminiBody = {
      contents,
      ...(system ? { systemInstruction: { parts: [{ text: system }] } } : {}),
      ...(Array.isArray(tools) && tools.length ? { tools: [{ functionDeclarations: tools }] } : {}),
      generationConfig: { temperature: 0.3, maxOutputTokens: 800 }
    };

    const geminiRes = await fetch(`${GEMINI_URL}?key=${apiKey}`, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(geminiBody)
    });

    if (!geminiRes.ok) {
      const errText = await geminiRes.text().catch(() => "");
      console.error("Gemini API error:", geminiRes.status, errText);
      // Surface Gemini's own error text (truncated) so the browser Network tab shows the real
      // cause (bad key, invalid model, quota, malformed request) instead of a bare 502.
      res.status(502).json({
        error: "Gemini API request failed.",
        geminiStatus: geminiRes.status,
        geminiMessage: errText.slice(0, 500)
      });
      return;
    }

    const data = await geminiRes.json();
    const candidate = data?.candidates?.[0];
    const parts = candidate?.content?.parts || [];

    if (!parts.length) {
      // No parts usually means Gemini blocked the response (safety filters) rather than an
      // actual outage — surface the reason instead of returning a silently empty answer.
      const reason = candidate?.finishReason || data?.promptFeedback?.blockReason || "unknown";
      res.status(200).json({ parts: [], blockReason: reason });
      return;
    }

    res.status(200).json({ parts });
  } catch (err) {
    console.error("Unexpected /api/chat error:", err);
    res.status(500).json({ error: "Unexpected server error.", detail: String(err && err.message || err) });
  }
};
